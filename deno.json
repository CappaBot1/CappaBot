{
    "tasks": {
        "prod": "deno run --allow-net --allow-env --allow-read --allow-write=db.json app.js",
        "dev": "deno run --watch='./*.js' --allow-net --allow-env --env-file=.env --allow-read --allow-write=db.json app.js"
    },
    "fmt": {
        "indentWidth": 4,
        "include": ["*.js", "*.ts"]
    },
    "imports": {
        "discord-interactions": "npm:discord-interactions@^4.0.0",
        "express": "npm:express"
    }
}
